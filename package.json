{
  "name": "declassified",
  "version": "1.0.0",
  "type": "module",
  "description": "A text-based investigative game exploring classified document cases",
  "main": "server-secure.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server-secure.js",
    "build": "vite build",
    "build:legacy": "node build.js",
    "build:prod": "NODE_ENV=production npm run typecheck && npm run test:run && npm run build",
    "preview": "vite preview",
    "start": "node server-secure.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist node_modules/.vite",
    "legacy": "node server.js",
    "static": "npx http-server -p 8080 -o",
    "optimize-images": "node optimize-images.js",
    "update-image-refs": "node update-image-refs.js",
    "validate-stripe": "node validate-stripe-setup.js",
    "generate-jwt-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:run:ios": "npx cap run ios",
    "cap:build": "npm run build && npx cap sync",
    "deploy:vercel": "npm run build:prod && vercel --prod",
    "deploy:github-pages": "npm run build:prod && gh-pages -d dist"
  },
  "keywords": [
    "game",
    "investigation",
    "interactive",
    "text-based",
    "capacitor",
    "ios"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@revenuecat/purchases-capacitor": "^12.0.0",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^14.21.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.0"
  }
}
