# ===========================================
# FRONTEND (Vite - prefix with VITE_)
# ===========================================

# Payment Server URL (Railway)
VITE_PAYMENT_SERVER_URL=https://the-classified-files-production-1c78.up.railway.app

# Stripe Publishable Key (public, safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# RevenueCat iOS API Key (for mobile app)
VITE_REVENUECAT_IOS_API_KEY=appl_your_key_here

# ===========================================
# BACKEND (Node.js server)
# ===========================================

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# JWT Secret for Purchase Verification
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters in production
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# Server Configuration
PORT=3000
NODE_ENV=production
